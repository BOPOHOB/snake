[Unit]
Description=Nokia 3310 Snake 2 (Deno API + SSR)
After=network.target

[Service]
Type=simple
User=bopohob
Group=bopohob
WorkingDirectory=/opt/snake/src/back
ExecStart=/usr/local/bin/deno run -A --env-file=/opt/snake/.env /opt/snake/src/back/src/main.ts
Restart=on-failure
RestartSec=3
Environment=HOST=127.0.0.1
Environment=PORT=8788
Environment=DENO_ENV=production
Environment=DB_PATH=/opt/snake/db.db
Environment=FRONTEND_ORIGIN=https://snake3310.io
Environment=OAUTH_REDIRECT_URI=https://snake3310.io/
Environment=COOKIE_SECURE=true

[Install]
WantedBy=multi-user.target
