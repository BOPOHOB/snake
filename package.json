{
  "name": "nokia3310-snake",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bash -c 'trap \"kill 0\" EXIT; (cd src/back && deno task dev) & exec vite'",
    "start": "vite",
    "build": "vite build && vite build --ssr src/front/entry.server.tsx",
    "build:client": "vite build",
    "build:server": "vite build --ssr src/front/entry.server.tsx",
    "preview": "vite preview",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.2",
    "antd": "^5.22.0",
    "classnames": "^2.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "less": "^4.2.0",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
