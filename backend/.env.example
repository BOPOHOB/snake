# Server
PORT=8787
HOST=127.0.0.1
# Path to SQLite file. Default: ../db.db (relative to backend/)
DB_PATH=../db.db

# Frontend origin for CORS (no trailing slash)
# dev:  http://localhost:3000
# prod: https://snake3310.io
FRONTEND_ORIGIN=http://localhost:3000

# OAuth redirect URI on the frontend (root, handled by the main page's OAuth effect)
# dev:  http://localhost:3000/
# prod: https://snake3310.io/
OAUTH_REDIRECT_URI=http://localhost:3000/

# Set to 1 / true if served over https (prod: 1)
COOKIE_SECURE=0

# Yandex OAuth
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
