{
  "name": "snake-backend",
  "exports": "./src/main.ts",
  "imports": {
    "hono": "jsr:@hono/hono@^4.11.4",
    "@std/path": "jsr:@std/path@^1.0.0"
  },
  "tasks": {
    "dev": "DENO_ENV=development deno run -A --env-file=.env --watch src/main.ts",
    "start": "deno run -A --env-file=.env src/main.ts"
  },
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.window", "deno.ns"]
  }
}
